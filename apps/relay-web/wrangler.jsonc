{
  "name": "relay-link",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-17",
  "cache": { "enabled": true },
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "relay.matari-audio.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "SessionRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-session-room", "new_sqlite_classes": ["SessionRoom"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
